# ── video-worker environment ─────────────────────────────────────────────────
# Copy to .env (gitignored) and fill in. Docker run:
#   docker run -d --env-file .env --name video-worker video-worker:latest

# Required — database + storage
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Video engines (at least one; used in fallback order)
# Sora 2 (OpenAI) — primary
OPENAI_API_KEY=sk-xxx
# Seedance / Kling (fal.ai) — secondary + fallback
FAL_KEY=xxx
# Veo (Gemini API) — evaluated at Phase 3 benchmark
GEMINI_API_KEY=xxx

# Optional tuning (defaults shown)
VIDEO_DRY_RUN=0          # 1 = synthesize placeholders locally, no API calls
WORKER_CONCURRENCY=3
WORKER_MAX_RETRIES=3
WORKER_STALE_MINUTES=15
POLL_INTERVAL_MS=5000
PORT=8080
